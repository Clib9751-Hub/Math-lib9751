        "- 第三\n",
        "\n",
        "1. 第一\n",
        "2. 第二\n",
        "3. 第三\n",
        "\n",
        "$E = mc^2$\n",
        "\n",
        "$$\n",
        "F = ma\n",
        "$$\n",
        "\n",
        "$$\n",
        "\\begin{aligned}\n",
        "x^2 - 4x + 3 &= 0 \\\\\n",
        "(x - 3)(x - 1) &= 0 \\\\\n",
        "\\end{aligned}\n",
        "$$\n",
        "\n",
